---
import { Image } from 'astro:assets';
import icon from '../assets/app-icon.png';
import { href } from '../lib/url';
import { release, REPO_URL } from '../data/release';

interface Props {
  overlay?: boolean;
  homePath?: string;
  labels?: { features: string; compare: string; privacy: string; download: string; github: string; menu: string; skip?: string };
}

const {
  overlay = false,
  homePath = '/',
  labels = { features: 'Features', compare: 'Compare', privacy: 'Privacy', download: 'Download', github: 'GitHub', menu: 'Menu' },
} = Astro.props;

const current = Astro.url.pathname;
const links = [
  { path: '/features/', label: labels.features },
  { path: '/cleanmymac-alternative/', label: labels.compare },
  { path: '/privacy/', label: labels.privacy },
];
const isCurrent = (path: string) => current.startsWith(href(path));
const stars = `${(release.starsFloor / 1000).toFixed(1).replace(/\.0$/, '')}k`;
---
<header class:list={['site-header', 'night', { overlay }]}>
  <div class="wrap bar">
    <a class="brand" href={href(homePath)} aria-label="Mac Sai home">
      <Image src={icon} alt="" width={36} height={36} loading="eager" />
      <span>Mac Sai</span>
    </a>

    <nav aria-label="Main">
      <ul class="links">
        {links.map((l) => (
          <li><a href={href(l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li>
          <a class="gh" href={REPO_URL} rel="noopener">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>{labels.github}</span>
            <span class="stars" aria-label={`${release.starsFloor}+ stars`}>{stars}</span>
          </a>
        </li>
      </ul>
    </nav>

    <a class="btn btn-primary dl" href={href('/download/')}>{labels.download}</a>

    <details class="menu">
      <summary aria-label={labels.menu}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </summary>
      <ul>
        {links.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}
        <li><a href={REPO_URL} rel="noopener">{labels.github}</a></li>
        <li><a href={href('/download/')}>{labels.download}</a></li>
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--night-line);
  }
  .site-header.overlay {
    position: absolute;
    inset: 0 0 auto;
    background: transparent;
    border-bottom-color: transparent;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--starlight);
    text-decoration: none;
    font: 700 1.2rem/1 var(--font-display);
    letter-spacing: -0.01em;
    margin-inline-end: auto;
  }
  .brand img { width: 36px; height: 36px; }
  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: var(--starlight-dim);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .links a:hover, .links a[aria-current='page'] { color: var(--starlight); background: rgb(255 255 255 / 0.07); }
  .gh svg { width: 1.05rem; height: 1.05rem; }
  .stars {
    font-size: 0.8rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.09);
    color: var(--starlight);
  }
  .dl { min-height: 2.5rem; padding: 0.45rem 1.1rem; font-size: 0.95rem; }

  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--starlight);
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary svg { width: 1.4rem; height: 1.4rem; fill: none; }
  .menu ul {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--night-raised);
    border: 1px solid var(--night-line);
    border-radius: var(--radius-m);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.6);
  }
  .menu li a {
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-s);
    color: var(--starlight);
    text-decoration: none;
  }
  .menu li a:hover { background: rgb(255 255 255 / 0.08); }

  @media (max-width: 52rem) {
    nav { display: none; }
    .menu { display: block; }
    .bar { gap: 0.5rem; }
  }
  @media (max-width: 22rem) {
    .dl { display: none; }
  }
</style>
