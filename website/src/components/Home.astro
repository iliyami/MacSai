---
import { Image } from 'astro:assets';
import AppWindow from './AppWindow.astro';
import InstallCommand from './InstallCommand.astro';
import ModuleExplorer, { type ExplorerGroup } from './ModuleExplorer.astro';
import Faq from './Faq.astro';
import DownloadBand from './DownloadBand.astro';
import Stats from './Stats.astro';
import nightSweepLTR from '../assets/art/night-sweep.jpg';
import nightSweepRTL from '../assets/art/night-sweep-rtl.jpg';
import glassRibbonLTR from '../assets/art/glass-ribbon.jpg';
import glassRibbonRTL from '../assets/art/glass-ribbon-rtl.jpg';
import { GROUPS, MODULES } from '../data/modules';
import { release } from '../data/release';
import { stats } from '../data/stats';
import { href } from '../lib/url';
import type { HomeStrings } from '../i18n/types';

interface Props { t: HomeStrings; locale: string; rtl?: boolean }
const { t, locale, rtl = false } = Astro.props;
// Artwork is mirrored for right-to-left pages so the crescent sits opposite the text.
const nightSweep = rtl ? nightSweepRTL : nightSweepLTR;
const glassRibbon = rtl ? glassRibbonRTL : glassRibbonLTR;

const number = new Intl.NumberFormat(locale);
const fill = (template: string, values: Record<string, string | number>) =>
  template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));

const downloadMeta = release.dmgSizeMB
  ? fill(t.hero.downloadMeta, { version: release.version, size: number.format(release.dmgSizeMB) })
  : fill(t.hero.downloadMeta.replace(/,?\s*\{size\}.*$/, ''), { version: release.version });

const groupShot: Record<string, string> = {
  cleanup: 'system-junk',
  protection: 'malware',
  performance: 'maintenance',
  applications: 'uninstaller',
  files: 'duplicates',
};
const groupPage: Record<string, string> = {
  cleanup: '/features/system-junk/',
  protection: '/features/malware-scanner/',
  performance: '/features/mac-maintenance/',
  applications: '/features/uninstaller/',
  files: '/features/disk-space/',
};
const english = locale === 'en';
const groups: ExplorerGroup[] = GROUPS.map((g) => ({
  id: g.id,
  name: t.modules.groups[g.id],
  shot: groupShot[g.id],
  shotAlt: t.modules.shotAlt[g.id],
  modules: MODULES.filter((m) => m.group === g.id).map((m) => t.modules.items[m.id] ?? { name: m.name, summary: m.summary }),
  href: href(groupPage[g.id]),
  linkLabel: english ? t.modules.more : `${t.modules.more} (${t.englishOnly ?? 'English'})`,
}));

const verifyCommand = `(
MACSAI_APP=$(cd "/Applications/Mac Sai.app" && pwd -P) || exit 1
MACSAI_PIDS=$(ps -ww -axo pid=,comm= | awk -v bundle="$MACSAI_APP/" '
  { pid=$1; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "")
    if (index($0, bundle) == 1) print pid }' | paste -sd, -)
if [ -n "$MACSAI_PIDS" ]; then
  ps -p "$MACSAI_PIDS" -o pid=,comm=
  lsof -nP -a -p "$MACSAI_PIDS" -i
else
  echo "No running executables from this Mac Sai bundle"
fi
)`;
const englishSuffix = english ? '' : ` (${t.englishOnly ?? 'English'})`;
---
<section class="hero night" aria-labelledby="hero-title">
  <Image
    src={nightSweep}
    alt=""
    class:list={['hero-art', { rtl }]}
    widths={[960, 1600, 2560]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    format="webp"
    quality={78}
  />
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="actions">
        <a class="btn btn-primary big" href={release.dmgURL}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {t.hero.download}
        </a>
        <p class="meta">{downloadMeta}<br />{t.hero.requirements}</p>
      </div>
      <div class="brew">
        <p>{t.hero.brewLabel}</p>
        <InstallCommand copyLabel={t.hero.copy} copiedLabel={t.hero.copied} label={t.hero.brewLabel} />
      </div>
    </div>
  </div>
  <div class="wrap hero-shot">
    <AppWindow name="smart-scan" alt={t.hero.shotAlt} priority sizes="(min-width: 72rem) 1100px, 94vw" />
  </div>
</section>

<section class="proof wrap" aria-label={t.stats.heading}>
  <p>
    <span>{fill(t.proof.downloads, { count: number.format(stats.downloads) })}</span>
    <span>{fill(t.proof.stars, { count: number.format(stats.stars) })}</span>
    <span>{t.proof.languages}</span>
    <span>{t.proof.trackers}</span>
  </p>
</section>

<section class="trust wrap" aria-labelledby="trust-title">
  <div class="trust-head">
    <h2 id="trust-title">{t.trust.heading}</h2>
    <p>{t.trust.intro}</p>
  </div>
  <dl class="trust-list">
    {t.trust.items.map((item) => (
      <div>
        <dt>{item.title}</dt>
        <dd>{item.body}</dd>
      </div>
    ))}
  </dl>
</section>

<section class="modules wrap" id="tools" aria-labelledby="modules-title">
  <div class="section-head">
    <h2 id="modules-title">{t.modules.heading}</h2>
    <p>{t.modules.intro}</p>
  </div>
  <ModuleExplorer groups={groups} label={t.modules.tabsLabel} />
</section>

<section class="dev wrap" aria-labelledby="dev-title">
  <div>
    <h2 id="dev-title">{t.developers.heading}</h2>
    <p>{t.developers.body}</p>
    <a href={href('/features/developer-cleanup/')}>{t.developers.link}{englishSuffix}</a>
  </div>
  <ul>
    {t.developers.items.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="verify night" aria-labelledby="verify-title">
  <Image src={glassRibbon} alt="" class:list={['verify-art', { rtl }]} widths={[960, 1600, 2560]} sizes="100vw" format="webp" quality={72} />
  <div class="wrap verify-inner">
    <div class="verify-copy">
      <h2 id="verify-title">{t.verify.heading}</h2>
      <p>{t.verify.body}</p>
      <p class="note">{t.verify.note}</p>
      <a href={href('/privacy/')}>{t.verify.link}{englishSuffix}</a>
    </div>
    <pre class="terminal" dir="ltr" tabindex="0" aria-label="Terminal command"><code>{verifyCommand}</code></pre>
  </div>
</section>

<section class="compare wrap" aria-labelledby="compare-title">
  <div class="section-head">
    <h2 id="compare-title">{t.compare.heading}</h2>
    <p>{t.compare.body}</p>
  </div>
  <div class="table-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
    <table>
      <thead>
        <tr><th scope="col">{t.compare.columns.feature}</th><th scope="col">{t.compare.columns.macsai}</th><th scope="col">{t.compare.columns.other}</th></tr>
      </thead>
      <tbody>
        {t.compare.rows.map((r) => (
          <tr><th scope="row">{r.label}</th><td>{r.macsai}</td><td>{r.other}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="footnote">{t.compare.footnote} <a href={href('/cleanmymac-alternative/')}>{t.compare.link}{englishSuffix}</a></p>
</section>

<Stats t={t.stats} locale={locale} />

<Faq heading={t.faq.heading} items={t.faq.items} />

<DownloadBand rtl={rtl} heading={t.cta.heading} body={t.cta.body} download={t.cta.download} meta={downloadMeta} copy={t.hero.copy} copied={t.hero.copied} brewLabel={t.hero.brewLabel} />

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(7.5rem, 14vw, 10.5rem);
    overflow: hidden;
  }
  .hero-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 78%;
    object-fit: cover;
    object-position: 70% 30%;
    z-index: -1;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .hero-art.rtl { object-position: 30% 30%; }
  .verify-art.rtl { object-position: 15% 50%; }
  .hero-copy { max-width: 40rem; }
  h1 {
    font-size: clamp(2.75rem, 1.5rem + 5.2vw, 5.6rem);
    font-variation-settings: 'opsz' 96;
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 720;
  }
  .lede {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--starlight-dim);
    max-width: 36rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }
  .big { min-height: 3.4rem; padding-inline: 1.6rem; font-size: 1.08rem; }
  .meta { font-size: 0.9rem; color: var(--starlight-dim); line-height: 1.45; }
  .brew { margin-top: 1.75rem; }
  .brew p { font-size: 0.9rem; color: var(--starlight-dim); margin-bottom: 0.5rem; }
  .hero-shot {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    position: relative;
  }
  .hero-shot::before {
    content: '';
    position: absolute;
    inset: 10% 8% -10%;
    background: radial-gradient(closest-side, rgb(140 110 255 / 0.45), transparent);
    filter: blur(40px);
    z-index: -1;
  }

  .proof {
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--line);
  }
  .proof p {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2.5rem;
    font: 600 var(--step-1) / 1.3 var(--font-display);
    color: var(--ink);
  }
  .proof span { white-space: nowrap; }

  .trust, .modules, .compare { padding-block: clamp(4rem, 9vw, 7rem); }
  .trust {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .trust-head p, .section-head p { margin-top: 1rem; color: var(--ink-2); font-size: var(--step-1); line-height: 1.5; max-width: 34rem; }
  .trust-head { position: sticky; top: 2rem; }
  .trust-list { margin: 0; display: grid; gap: 2rem; }
  .trust-list div { padding-top: 1.25rem; border-top: 1px solid var(--line); }
  dt { font: 650 var(--step-1) / 1.3 var(--font-display); }
  dd { margin: 0.4rem 0 0; color: var(--ink-2); }

  .section-head { margin-bottom: clamp(2rem, 5vw, 3.5rem); max-width: 44rem; }
  .modules { border-top: 1px solid var(--line); }

  .dev {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem clamp(2rem, 6vw, 6rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .dev p { margin: 1rem 0 1.25rem; color: var(--ink-2); font-size: var(--step-1); line-height: 1.5; }
  .dev a { font-weight: 600; }
  .dev ul { list-style: none; margin: 0; padding: 0; align-self: center; }
  .dev li {
    font-weight: 500;
    font-size: var(--step-0);
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .dev li:first-child { border-top: 1px solid var(--line); }

  .verify {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }
  .verify-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 85% 50%;
    opacity: 0.55;
    z-index: -1;
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }
  .verify-inner {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2.5rem clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .verify-copy p { margin-top: 1rem; color: var(--starlight-dim); font-size: var(--step-1); line-height: 1.5; }
  .verify-copy .note { font-size: var(--step-0); }
  .verify-copy a { display: inline-block; margin-top: 1.25rem; font-weight: 600; }
  .terminal {
    margin: 0;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-l);
    background: rgb(8 6 26 / 0.82);
    border: 1px solid var(--night-line);
    backdrop-filter: blur(12px);
    color: #dcd8ff;
    font-size: 0.82rem;
    line-height: 1.6;
    overflow-x: auto;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8);
  }

  .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-l); background: var(--surface); }
  table { width: 100%; border-collapse: collapse; min-width: 34rem; }
  th, td { text-align: start; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font-size: 0.9rem; color: var(--ink-2); font-weight: 600; }
  thead th:nth-child(2) { color: var(--accent); }
  tbody th { font-weight: 500; color: var(--ink-2); width: 38%; }
  tbody td:nth-child(2) { font-weight: 600; }
  .footnote { margin-top: 1.25rem; font-size: 0.92rem; color: var(--ink-2); max-width: var(--measure); }

  @media (max-width: 56rem) {
    .trust, .dev, .verify-inner { grid-template-columns: 1fr; }
    .trust-head { position: static; }
  }
  @media (max-width: 34rem) {
    .proof p { gap: 0.4rem 1.5rem; font-size: 1.05rem; }
    .hero-art { height: 55%; object-position: 82% 30%; opacity: 0.4; }
  }
  h1:is(:lang(fa), :lang(ja), :lang(ko), :lang(zh-Hans), :lang(zh-Hant)) { letter-spacing: 0; }
</style>
